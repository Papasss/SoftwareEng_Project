{
  "info": {
    "name": "Participium API Acceptance Tests",
    "_postman_id": "d3a18d71-9fc1-4a5a-9f2b-1bc121bbabe7",
    "description": "External acceptance test suite for the Participium backend. Run against a local backend with seeded demo data.",
