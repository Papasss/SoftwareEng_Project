    {
      "name": "Public Data",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/categories",
            "description": "Retrieve active report categories."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Categories list returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const categories = pm.response.json();",
                  "pm.test(\"Categories list is an array\", function () {",
                  "    pm.expect(categories).to.be.an(\"array\");",
                  "    pm.expect(categories.length).to.be.above(0);",
                  "});",
                  "const preferred = categories.find(c => c.name === \"Roads and Urban Furniture\") || categories[0];",
                  "pm.expect(preferred).to.be.ok;",
                  "pm.environment.set(\"report_category_id\", preferred.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List public reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reports",
            "description": "Retrieve the list of published reports visible to all users."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Public reports list returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const reports = pm.response.json();",
                  "pm.test(\"Public reports list is an array\", function () {",
                  "    pm.expect(reports).to.be.an(\"array\");",
                  "});",
                  "if (reports.length) {",
                  "    pm.environment.set(\"public_report_id\", reports[0].id);",
                  "}",
                  "pm.expect(reports.length).to.be.above(0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get public report detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/reports/{{public_report_id}}",
            "description": "Verify public report details are returned for an existing report."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Public report detail returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const report = pm.response.json();",
                  "pm.test(\"Public report detail contains id and status\", function () {",
                  "    pm.expect(report.id).to.eql(parseInt(pm.environment.get(\"public_report_id\")));",
                  "    pm.expect(report.status).to.be.a(\"string\");",
                  "});"
