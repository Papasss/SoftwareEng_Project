            "description": "Verify unauthenticated access is rejected."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated profile access returns 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Unauthenticated response contains error\", function () {",
                  "    pm.expect(body.error).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identifier\": \"{{citizen_email}}\", \"password\": \"{{citizen_password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Authenticate as the seeded citizen user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Citizen login returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Citizen user is returned\", function () {",
                  "    pm.expect(body.user.email).to.eql(pm.environment.get(\"citizen_email\"));",
                  "    pm.expect(body.user.role).to.eql(\"citizen\");",
                  "});",
                  "pm.environment.set(\"current_user_id\", body.user.id);",
                  "pm.environment.set(\"current_user_role\", body.user.role);"
                ]
              }
            }
          ]
        },
