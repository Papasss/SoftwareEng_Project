          "name": "Login as citizen for citizen workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identifier\": \"{{citizen_email}}\", \"password\": \"{{citizen_password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/auth/login",
            "description": "Authenticate as the seeded citizen user for the citizen workflow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Citizen login returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Citizen user is returned\", function () {",
                  "    pm.expect(body.user.email).to.eql(pm.environment.get(\"citizen_email\"));",
                  "    pm.expect(body.user.role).to.eql(\"citizen\");",
                  "});",
                  "pm.environment.set(\"current_user_id\", body.user.id);",
                  "pm.environment.set(\"current_user_role\", body.user.role);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create report",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "{{created_report_title}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Report created by the Postman acceptance suite.",
                  "type": "text"
                },
                {
                  "key": "category_id",
                  "value": "{{report_category_id}}",
                  "type": "text"
                },
                {
                  "key": "latitude",
                  "value": "45.0703",
                  "type": "text"
                },
                {
                  "key": "longitude",
                  "value": "7.6869",
                  "type": "text"
                },
                {
                  "key": "is_anonymous",
                  "value": "false",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": "../../../data/official-documentation/03-use-cases/03a-UseCaseDiagram.svg"
                }
              ]
            }
          ,
            "url": "{{base_url}}/reports",
            "description": "Create a new citizen report."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Date.now();",
                  "pm.environment.set(\"created_report_title\", `Postman report ${timestamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Create report returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const report = pm.response.json();",
                  "pm.test(\"Created report status is pending_approval\", function () {",
                  "    pm.expect(report.status.toLowerCase().replace(/ /g, '_')).to.eql(\"pending_approval\");",
                  "});",
                  "pm.test(\"Created report includes id\", function () {",
                  "    pm.expect(report.id).to.be.a(\"number\");",
                  "});",
                  "pm.environment.set(\"created_report_id\", report.id);"
                ]
              }
            }
          ]
        },
