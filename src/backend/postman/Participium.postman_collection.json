  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Verify the service is available."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health endpoint returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Health response contains status=ok\", function () {",
                  "    pm.expect(body.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reference data",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/meta/reference-data",
            "description": "Retrieve domain enums used by the frontend."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Reference data returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"Reference data contains roles\", function () {",
                  "    pm.expect(body.roles).to.be.an(\"array\");",
                  "    pm.expect(body.roles).to.include(\"citizen\");",
                  "});",
                  "pm.test(\"Reference data contains report statuses\", function () {",
                  "    pm.expect(body.report_statuses).to.be.an(\"array\");",
                  "    pm.expect(body.report_statuses.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
